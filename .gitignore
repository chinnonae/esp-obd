.pio
# Generated by PlatformIO IDE in whichever folder holds platformio.ini
# (firmware/.vscode/ in the monorepo workspace).
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch

# Python envs, e.g. firmware/.venv (zig toolchain for the native tests).
.venv/

# Local WiFi secrets: never commit.
wifi_credentials.h

# Dashboard drive recordings (large local data).
apps/dashboard/recordings/
